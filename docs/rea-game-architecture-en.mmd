flowchart TB
  subgraph intake["01 · LOCAL INTAKE & EXTRACTION"]
    direction LR
    video(["Gameplay recording<br/>Local MP4 / MOV"]):::input
    cli["Python CLI<br/>Argument and path checks"]:::process
    probe["ffprobe<br/>Track · duration · dimensions · audio"]:::process
    ffmpeg["FFmpeg<br/>Seek · decode · scale · JPEG"]:::process
    artifacts["Extraction outputs<br/><b>frames/</b> · timestamped images<br/><b>evidence.json</b> · source and frame index<br/><b>review.json</b> · section template"]:::artifact
    video --> cli --> probe --> ffmpeg --> artifacts
  end

  subgraph humanReview["02 · HUMAN REVIEW"]
    direction LR
    analyst["Human or vision assistant<br/>Inspect frames · replay key moments · review audio"]:::human
    completed["Completed review.json<br/>Observations · inferences<br/>Unverified questions · proposals"]:::human
    analyst --> completed
  end

  subgraph reporting["03 · LOCAL REPORTING"]
    direction LR
    reportCli["Python CLI · rea-game report<br/>Read evidence.json + review.json"]:::process
    validate{"Validate review<br/>Sections · fields · statuses<br/>Timestamp bounds · evidence rules"}:::gate
    report(["report.md<br/>Evidence-linked analysis<br/>Prototype plan · open questions"]):::output
    prototype(["Next step<br/>Build a playable prototype"]):::next
    reportCli --> validate
    validate -->|Valid| report --> prototype
    validate -.->|Invalid · correct JSON and rerun| reportCli
  end

  intake -->|Frames + evidence| humanReview
  humanReview -->|Completed review.json| reporting

